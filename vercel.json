{
  "redirects": [
    {
      "source": "/tools/asahikawa-hotels-compare",
      "destination": "/tools/hotel-compare?hub=asahikawa",
      "permanent": true
    },
    {
      "source": "/tools/hotel-compare/:hub",
      "destination": "/tools/hotel-compare?hub=:hub",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
